{
  "name": "graph-bro",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "graph-bro": "dist/cli/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "postbuild": "mkdir -p dist/store/migrations && cp src/store/migrations/*.sql dist/store/migrations/ && chmod +x dist/cli/index.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
