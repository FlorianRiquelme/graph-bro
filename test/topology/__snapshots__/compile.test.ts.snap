        "batch.items": [
          "a",
          "b",
          "c",
        ],
      },
    },
    {
      "id": "reader",
      "kind": "agent",
      "model": "claude-haiku",
      "output_key": "finding",
      "prompt": "read \${item}",
      "read_only": true,
    },
    {
      "id": "collector",
      "kind": "set",
      "update": {
        "collected": true,
      },
    },
  ],
  "plainEdges": [
    {
      "from": "START",
      "to": "dispatch",
    },
    {
      "from": "collector",
      "to": "END",
    },
  ],
}
